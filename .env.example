# Google AI Studio / Gemini API key (server-side only, never commit the real one)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Voice needs no key: Kokoro-82M (voice) and Whisper base.en (listening) run in the browser.
